# Required
JWT_SECRET=change-this-to-a-long-random-secret-string

# Your backend public URL (used by frontend to connect Socket.IO)
# e.g. https://api.yourdomain.com  OR  http://YOUR_VPS_IP:5000
VITE_API_URL=https://api.yourdomain.com

# AI Keys (add what you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_AI_PROVIDER=gemini
